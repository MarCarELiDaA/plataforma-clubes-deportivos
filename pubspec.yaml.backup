name: padel_navales
description: "A new Flutter project."
publish_to: 'none'

version: 1.0.0+1

environment:
  sdk: ^3.10.7

dependencies:
  flutter:
    sdk: flutter
  flutter_localizations:
    sdk: flutter
  
  firebase_core: 3.6.0
  firebase_auth: 5.3.1
  cloud_firestore: 5.4.4
  google_sign_in: ^6.2.1
  
  connectivity_plus: ^6.0.3
  intl: ^0.20.2
  shared_preferences: ^2.2.2
  flutter_local_notifications: ^17.2.3
  timezone: ^0.9.4
  url_launcher: ^6.3.1

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_launcher_icons: ^0.14.1
  flutter_lints: ^5.0.0

flutter:
  uses-material-design: true

  assets:
    - assets/images/logofinal1.png
    - assets/images/pistanavales.png

flutter_launcher_icons:
  android: true
  ios: true
  image_path: "assets/images/logofinal1.png"
  adaptive_icon_background: "#182B50"
  adaptive_icon_foreground: "assets/images/logofinal1.png"